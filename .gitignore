# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Base de données SQLite locale (contient des données & hash de mots de passe)
db/*.db
db/*.db-journal

# Fichiers d'état éphémères de la sandbox
.zscripts/dev.pid
*.pid

# Sauvegardes locales de bases & env (peuvent contenir des secrets)
db/*.bak*
db/*.sqlite*
.env.bak*

# Artefacts éphémères des outils d'agent (Read tool output)
tool-results/

# Le modèle de configuration DOIT être versionné (malgré le pattern .env*)
!.env.example
.zscripts/shots/

# Fichiers internes de travail / collés (jamais versionnés)
upload/
