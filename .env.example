# ============================================================
# NZOKO TRANSPORT — Variables d'environnement (exemple)
# Copier ce fichier en `.env` puis adapter les valeurs.
# ============================================================

# Base de données PostgreSQL (Neon) — depuis la migration du 2026-09-17.
#  - DATABASE_URL : connexion POOLÉE (PgBouncer) utilisée par le runtime
#    Next.js — ajouter pgbouncer=true (désactive les prepared statements
#    incompatibles avec le pooling en mode transaction) + connection_limit.
#    C'est cette URL qu'il faut définir dans les variables Vercel.
#  - DIRECT_DATABASE_URL : connexion DIRECTE (hôte SANS « -pooler »)
#    utilisée par le CLI Prisma pour le DDL (db push / migrate).
# NB : l'ancienne base SQLite est conservée en sauvegarde locale
#      (db/custom.sqlite.bak-pre-neon, non versionnée).
DATABASE_URL="postgresql://<utilisateur>:<motdepasse>@<projet>-pooler-<region>.aws.neon.tech/<base>?sslmode=require&pgbouncer=true&connection_limit=5"
DIRECT_DATABASE_URL="postgresql://<utilisateur>:<motdepasse>@<projet>-<region>.aws.neon.tech/<base>?sslmode=require"

# Suivi GPS temps réel — secret partagé entre l'app Next.js et le
# mini-service socket.io (mini-services/tracking-realtime). Le même
# TRACKING_SECRET doit être défini des deux côtés en production.
#TRACKING_SECRET=changez-moi-en-production
# URL interne du mini-service socket.io (pont d'émission best-effort).
#TRACKING_REALTIME_URL=http://127.0.0.1:3004
# URL FRONTALE du service temps réel consommée par le navigateur admin :
#  - laissé par défaut → passerelle sandbox (/?XTransformPort=3003) ;
#  - URL publique (ex. https://tracking.nzoko.cg) si le mini-service est
#    déployé ailleurs (VPS/Railway/Fly — incompatible serverless Vercel) ;
#  - CHAÎNE VIDE ("") → temps réel désactivé, l'admin suit la flotte en
#    polling 10 s (aucune tentative socket, aucune erreur console).
#TRACKING_PUBLIC_SOCKET_URL=""

# Durabilité GPS en production (watchdog sessions orphelines + rétention).
# Le scheduler du mini-service appelle la route en interne (HMAC) ; sur un
# hébergement serverless SANS mini-service, c'est le cron de la plateforme
# qui prend le relais :
#  - Vercel : vercel.json déclare un cron quotidien → définir CRON_SECRET
#    (Vercel envoie « Authorization: Bearer <CRON_SECRET> » sur
#    GET /api/tracking/maintenance). Pour une précision de 5 min, passer
#    le projet en plan Pro et changer le schedule, OU utiliser un cron
#    externe gratuit (cron-job.org) avec le même en-tête Bearer.
#  - Ailleurs : POST signé HMAC toutes les 5 min depuis n'importe quel
#    ordonnanceur (x-signature = HMAC-SHA256(TRACKING_SECRET, corps)).
#CRON_SECRET=changez-moi-aussi-en-production

# URL interne du serveur Next, utilisée par le scheduler de maintenance
# du mini-service (watchdog sessions orphelines + rétention GPS).
#NEXT_INTERNAL_URL=http://127.0.0.1:3000

# Paiements — mode simulation démo tant que les intégrations Mobile Money
# officielles (MTN MoMo, Airtel) ne sont pas configurées.
#PAYMENTS_SIMULATION=true

# Neon Auth (Managed Better Auth) — comptes clients.
# NEON_AUTH_BASE_URL : console Neon → Project → Branch → Auth → Configuration.
# NEON_AUTH_COOKIE_SECRET : openssl rand -base64 32 (minimum 32 caractères).
# ⚠️ Le secret doit être IDENTIQUE partout où la session est partagée.
# Absentes → auth locale NZOKO uniquement (routes Neon en 503).
#NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/<base>/auth
#NEON_AUTH_COOKIE_SECRET=generer-avec-openssl-rand-base64-32
#
# NEON_AUTH_MODE : "neon" (production — identité/session centralisées Neon
# Auth : téléphone+OTP, e-mail+mot de passe, pont d'import des comptes
# internes) ou "local" (stub de DÉVELOPPEMENT uniquement — bcrypt + OTP
# locaux, pour les sandbox sans URL HTTPS publique pour le webhook).
#NEON_AUTH_MODE=neon
#
# Compte de service admin Neon (provisioning téléphone + pont d'import).
# Création : bun scripts/neon-create-service-account.ts — puis vérifier
# l'e-mail (code reçu dans la boîte du propriétaire) et « Make admin »
# dans la console Neon (Auth → Users → ⋮).
#NEON_AUTH_SERVICE_EMAIL=
#NEON_AUTH_SERVICE_PASSWORD=
#
# Livraison des codes OTP (webhook /api/webhooks/neon-auth) :
# ⚠️ Dès que le webhook send.otp est configuré dans la console Neon,
# Neon n'envoie PLUS les e-mails OTP lui-même : c'est l'application qui
# livre (SMS + e-mail) via ces adaptateurs — jamais de secret côté client.
#SMS_PROVIDER=log            # esms | africastalking | twilio | log
#EMAIL_PROVIDER=log          # smtp | resend | log
# eSMS Africa (esmsafrica.io — recommandé, Congo-Brazzaville MTN · Airtel).
# Clé : dashboard eSMS Africa → Développeurs → API Keys (esms_live_… en
# production, esms_test_… pour un bac à sable facturé 0 — jamais envoyé).
#ESMS_API_KEY=
#ESMS_SENDER_ID=             # optionnel (sender ID validé, sinon défaut route)
#ESMS_BASE_URL=              # optionnel (défaut https://sms.esmsafrica.io/api)
#AFRICASTALKING_API_KEY=
#AFRICASTALKING_USERNAME=
#AFRICASTALKING_SENDER_ID=
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=NZOKO Transport <contact@nzoko.cg>
#RESEND_API_KEY=
#RESEND_FROM=NZOKO Transport <onboarding@resend.dev>
# ============================================================
# V4 — CARTOGRAPHIE OUVERTE (sans Google)
# Tuiles raster Leaflet : aucune clé d'API, aucun coût, aucune donnée
# envoyée à un tiers. Ces variables sont préfixées NEXT_PUBLIC_ car le
# navigateur doit connaître l'URL des tuiles.
# ============================================================

# Fournisseur de fond de carte (identifiant d'affichage).
#NEXT_PUBLIC_MAP_PROVIDER=openstreetmap

# Template de tuiles raster au format Leaflet {z}/{x}/{y}.
# C'est la SEULE URL de tuile du projet — les cartes consomment
# GET /api/tracking/config (champ map.tileUrl), jamais d'URL en dur.
#NEXT_PUBLIC_MAP_STYLE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Attribution légale affichée en bas de chaque carte (HTML).
#NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# Centre par défaut des cartes (Brazzaville, Congo).
#NEXT_PUBLIC_MAP_DEFAULT_LAT=-4.27
#NEXT_PUBLIC_MAP_DEFAULT_LNG=15.28

# ============================================================
# V4 — GPS ÉTENDU (seuils serveur)
# Lues CÔTÉ SERVEUR uniquement dans src/lib/gps-config.ts : le navigateur
# reçoit les valeurs EFFECTIVES via GET /api/tracking/config (aucun secret).
# ============================================================

# Intervalles d'envoi du hook chauffeur (millisecondes) :
#  - en mouvement (GPS actif) ;
#  - vitesse lente / circulation dense ;
#  - à l'arrêt (gare, pause, embouteillage).
#GPS_ACTIVE_INTERVAL=8000
#GPS_IDLE_INTERVAL=15000
#GPS_STOPPED_INTERVAL=30000

# Secondes sans position au-delà desquelles un bus passant OFFLINE
# sur les cartes et le tableau de bord flotte.
#GPS_OFFLINE_THRESHOLD=120

# Rayon (mètres) autour de la destination officielle du voyage qui
# déclenche la détection d'arrivée automatique (trip → ARRIVED).
#GPS_ARRIVAL_RADIUS=2000

# Seuil km/h en dessous duquel un bus suivi est considéré STOPPED
# (défaut : TRACKING.stoppedSpeedKmh = 5).
#TRACKING_GPS_STOPPED_SPEED=5

# Base OSRM pour le routage routier RÉEL des lignes (open source, sans
# Google). Chaîne vide = désactivé : les tracés de lignes sont alors des
# lignes droites entre villes (scripts/generate-route-geometry.ts).
# Exemple public de démonstration : https://router.project-osrm.org
#OSRM_BASE_URL=

# Exposer les positions des bus (sessions GPS actives) sur la carte
# publique /api/map/public — données volontairement minimales (aucun nom
# de chauffeur, aucune immatriculation, aucune agence). "false" = buses [].
#PUBLIC_BUS_POSITIONS=false

# ============================================================
# API CENTRALE — authentification service-à-service (multi-sites)
# ============================================================
# Le SITE AGENCES (autre déploiement Next.js) appelle cette API avec :
#   Authorization: Bearer <CENTRAL_API_SECRET>
# Génération : openssl rand -base64 48  (≥ 32 caractères requis)
# JAMAIS de préfixe NEXT_PUBLIC_ : secret serveur uniquement.
# Les lecteurs publics (agences, voyages, sièges) restent ouverts ;
# les mutations (hold, confirm, cancel, payments/webhook) l'acceptent.
CENTRAL_API_SECRET=
