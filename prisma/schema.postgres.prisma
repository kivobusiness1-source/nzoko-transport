// NZOKO TRANSPORT — Schéma Prisma PRODUCTION (PostgreSQL / Neon)
// ⚠️ DOUBLE SCHÉMA (2026-09-20, cf. worklog Task 34) :
//   - prisma/schema.prisma = SQLite, utilisé par la sandbox locale (bun run
//     dev, db:push, seed) — ne JAMAIS générer depuis ce fichier en local.
//   - CE FICHIER = PostgreSQL/Neon, utilisé par le build Vercel :
//     "prisma generate --schema prisma/schema.postgres.prisma" est le
//     PREMIER pas du script build de package.json → le client embarqué dans
//     les fonctions serverless cible Neon via DATABASE_URL (pooler, variable
//     Vercel) ; DIRECT_DATABASE_URL (hôte sans -pooler) sert uniquement au
//     DDL (db push / migrate) exécuté depuis un poste ayant les identifiants.
//   - Les DEUX fichiers doivent rester synchrones : mêmes modèles, seuls le
//     bloc datasource et les commentaires diffèrent. Toute évolution du
//     modèle DOIT être répercutée dans les deux fichiers.
//  - les "enums" sont des champs String validés côté application (src/lib/constants.ts + Zod)
//  - les champs JSON sont des String sérialisés (helpers parse/stringify)
//  - les montants sont des entiers (XAF/FCFA — pas de sous-unité)
// ⚠️ Modèle AiQuestionLog : NE JAMAIS le renommer avec un acronyme en tête
//    ("AIQuestionLog") — la casse du client généré (aIQuestionLog vs
//    aiQuestionLog) varie selon les versions/générateurs Prisma. Le nom
//    `AiQuestionLog` (+ @@map("AIQuestionLog") pour conserver la table) est
//    déterministe : db.aiQuestionLog partout, sur toutes les versions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // pooler (runtime serverless)
  directUrl = env("DIRECT_DATABASE_URL") // DDL (db push / migrate)
}

// ============================================================
// IDENTITÉ, RÔLES & SESSIONS
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique // E.164 digits (ex: 242061234567) — unicité requise pour OTP/récupération
  supabaseId   String?   @unique // UUID du compte dans Supabase Auth (clients) — null = mot de passe local
  firstName    String
  lastName     String
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  agencyId     String?
  agency       Agency?   @relation(fields: [agencyId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  securityLogs   SecurityLog[]
  bookingsMade   Booking[]      @relation("BookingCreator")
  paymentsMade   Payment[]      @relation("PaymentCollector")
  ticketsChecked Ticket[]       @relation("TicketChecker")
  expenses       Expense[]
  transactions   Transaction[]
  driver         Driver?

  // V3 — responsabilités & base de connaissances IA
  managedAgencies  Agency[]        @relation("AgencyManager")
  knowledgeCreated KnowledgeBase[] @relation("KBCreatedBy")
  knowledgeUpdated KnowledgeBase[] @relation("KBUpdatedBy")

  // Espace client & fidélisation
  loyaltyAccount      LoyaltyAccount?
  favoriteRoutes      FavoriteRoute[]
  complaintsAuthored  Complaint[]         @relation("ComplaintAuthor")
  complaintsAssigned  Complaint[]         @relation("ComplaintAssignee")
  complaintMessages   ComplaintMessage[]  @relation("ComplaintMessages")
  tripRatings         TripRating[]        @relation("TripRatings")
  redemptionRequests  RedemptionRequest[] @relation("RedemptionRequester")
  redemptionDecisions RedemptionRequest[] @relation("RedemptionDecider")
  passengerProfiles   Passenger[]         @relation("PassengerAccount")

  @@index([roleId])
  @@index([agencyId])
  @@index([isActive])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique // SUPER_ADMIN | ADMIN | AGENCY_MANAGER | AGENT | CHECKER | ACCOUNTANT | DRIVER | SUPPORT | PASSENGER
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]

  @@index([code])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // ex: "trip:manage"
  name        String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id         String    @id // SHA-256 du token cookie (jamais le token brut)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// GÉOGRAPHIE & RÉSEAU
// ============================================================

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique // "pointe-noire" — V3 géolocalisation/SEO
  country   String   @default("CG") // code pays ISO — extensible RDC, Gabon, Cameroun, Angola...
  latitude  Float? // V3 — centre géographique (GPS client : détection de ville)
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencies             Agency[]
  neighborhoods        Neighborhood[]
  routesOrigin         Route[]         @relation("RouteOrigin")
  routesDest           Route[]         @relation("RouteDestination")
  routeStops           RouteStop[]
  favoriteOrigins      FavoriteRoute[] @relation("FavoriteOrigin")
  favoriteDestinations FavoriteRoute[] @relation("FavoriteDestination")
  knowledgeBases       KnowledgeBase[]
  aiQuestionLogs       AiQuestionLog[]

  @@unique([name, country])
  @@index([isActive])
  @@index([country])
}

// V3 — Quartier / zone d'une ville : "Vous êtes probablement à [quartier]".
// Le rayon sert à la détection approximative côté serveur (Haversine point↔centre).
model Neighborhood {
  id           String   @id @default(cuid())
  cityId       String
  city         City     @relation(fields: [cityId], references: [id])
  name         String
  slug         String
  latitude     Float?
  longitude    Float?
  radiusMeters Int      @default(2500) // rayon de rattachement approximatif
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agencies Agency[]

  // Achat billet — quartier d'arrêt choisi par le passager (destination).
  dropOffBookings Booking[] @relation("BookingDropOff")

  @@unique([cityId, slug])
  @@index([cityId, isActive])
  @@index([isActive])
}

model Agency {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  cityId         String
  city           City          @relation(fields: [cityId], references: [id])
  neighborhoodId String? // V3 — quartier/zone d'implantation
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  address        String?
  phone          String?
  email          String?
  description    String? // V3 — instructions d'accès, services
  latitude       Float? // V3 — position GPS (recommandation d'agence)
  longitude      Float?
  openingTime    String? // V3 — "06:30" heure locale Congo
  closingTime    String? // V3 — "20:00"
  managerId      String? // V3 — responsable d'agence (AGENCY_MANAGER)
  manager        User?         @relation("AgencyManager", fields: [managerId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users            User[]
  buses            Bus[]
  drivers          Driver[]
  trips            Trip[]
  bookings         Booking[]
  transactions     Transaction[]
  expenses         Expense[]
  trackingSessions TrackingSession[]
  knowledgeBases   KnowledgeBase[]
  aiQuestionLogs   AiQuestionLog[]

  @@index([cityId])
  @@index([cityId, isActive])
  @@index([neighborhoodId])
  @@index([isActive])
}

model Route {
  id                       String   @id @default(cuid())
  code                     String   @unique
  originCityId             String
  originCity               City     @relation("RouteOrigin", fields: [originCityId], references: [id])
  destinationCityId        String
  destinationCity          City     @relation("RouteDestination", fields: [destinationCityId], references: [id])
  distanceKm               Int
  estimatedDurationMinutes Int
  basePrice                Int // XAF
  // V4 GPS — tracé routier de la ligne : LineString GeoJSON SÉRIALISÉE en JSON,
  // convention GeoJSON OBLIGATOIRE [longitude, latitude] :
  //   {"type":"LineString","coordinates":[[lng,lat],[lng,lat],…]}
  // Peuplé par scripts/generate-route-geometry.ts (OSRM routage réel si
  // OSRM_BASE_URL est configuré, sinon lignes droites entre villes). Null = pas de tracé.
  geometryJson             String?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  stops RouteStop[]
  trips Trip[]

  @@unique([originCityId, destinationCityId])
  @@index([isActive])
}

model RouteStop {
  id               String   @id @default(cuid())
  routeId          String
  route            Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  cityId           String
  city             City     @relation(fields: [cityId], references: [id])
  position         Int // ordre croissant, 0 = origine
  minutesFromStart Int // temps estimé depuis le départ (minutes)
  // V5 GPS — rayon de géofence de l'arrêt (mètres). null = défaut config.
  radiusM          Int?
  createdAt        DateTime @default(now())

  @@unique([routeId, position])
  @@index([routeId])
  @@index([cityId])
}

// ============================================================
// PARC & CONFIGURATION SIÈGES
// ============================================================

model SeatLayout {
  id          String   @id @default(cuid())
  name        String   @unique
  rows        Int // nombre de rangées
  columns     Int // nombre de sièges par rangée (hors couloir)
  aisleAfter  Int // position du couloir : nb de sièges à gauche (2+2 => 2 ; 1+2 => 1)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seats Seat[]
  buses Bus[]
}

model Seat {
  id           String     @id @default(cuid())
  seatLayoutId String
  seatLayout   SeatLayout @relation(fields: [seatLayoutId], references: [id], onDelete: Cascade)
  seatNumber   String // ex: "01", "12"
  row          Int // 1..rows
  column       String // A, B, C, D...
  type         String     @default("STANDARD") // STANDARD | VIP
  createdAt    DateTime   @default(now())

  bookings    Booking[]
  occupancies SeatOccupancy[]

  @@unique([seatLayoutId, seatNumber])
  @@index([seatLayoutId])
  @@index([type])
}

model Bus {
  id                 String     @id @default(cuid())
  registrationNumber String     @unique
  brand              String
  model              String
  year               Int?
  capacity           Int
  status             String     @default("ACTIVE") // ACTIVE | MAINTENANCE | INACTIVE | OUT_OF_SERVICE
  agencyId           String
  agency             Agency     @relation(fields: [agencyId], references: [id])
  seatLayoutId       String
  seatLayout         SeatLayout @relation(fields: [seatLayoutId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  trips            Trip[]
  trackingSessions TrackingSession[]

  @@index([agencyId])
  @@index([status])
}

// ============================================================
// SUIVI GPS TEMPS RÉEL — une session par trajet/portion de trajet
// V5 multi-bus : deviceId, état courant dénormalisé (anti N+1,
// anti-hors-ordre), heartbeat séparé, géofence arrêts, tripPhase
// technique distincte du statut métier, endReason d'audit.
// ============================================================
model TrackingSession {
  id        String    @id @default(cuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  tripId    String? // voyage rattaché (null = repositionnement/entretien)
  trip      Trip?     @relation(fields: [tripId], references: [id])
  busId     String?
  bus       Bus?      @relation(fields: [busId], references: [id])
  agencyId  String
  agency    Agency    @relation(fields: [agencyId], references: [id])
  status    String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  // V5 — identifiant du téléphone émetteur (UUID client, localStorage).
  deviceId  String?
  // V5 — état courant dénormalisé (anti N+1 + anti-hors-ordre).
  lastPositionAt DateTime?
  lastLatitude    Float?
  lastLongitude   Float?
  lastSpeed       Float? // km/h
  lastHeading     Float? // degrés 0–360
  lastAccuracy    Float? // mètres
  // V5 — batterie du téléphone au dernier point (affichage flotte).
  lastBatteryLevel Float? // 0–100
  // V5 — heartbeat : téléphone encore connecté (≠ position fraîche).
  lastHeartbeatAt DateTime?
  // V5 — moteur géofence : arrêt courant + date d'entrée (dwell).
  geofenceStopId    String?
  geofenceEnteredAt DateTime?
  // V5 — phase technique GPS (distincte du statut métier Trip).
  tripPhase String? // IN_TRANSIT | AT_STOP | ARRIVING
  // V5 — raison de fin de session (audit).
  endReason String? // DRIVER | WATCHDOG | ARRIVAL | CONFLICT | ADMIN
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  points GpsPoint[]

  @@index([status, agencyId])
  @@index([driverId, startedAt])
  @@index([tripId])
  // V5 — conflits bus (un seul suivi actif par car) + vue flotte.
  @@index([busId, status])
  @@index([driverId, status])
  @@index([status, lastPositionAt])
}

model GpsPoint {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrackingSession @relation(fields: [sessionId], references: [id])
  // V5 — identifiant d'idempotence généré PAR LE CLIENT à la capture
  // (UUID) : double envoi / retry / re-synchronisation offline ne
  // crée JAMAIS deux lignes (contrainte d'unicité ci-dessous).
  positionId   String?
  latitude     Float
  longitude    Float
  speed        Float? // km/h (m/s × 3,6 côté client)
  heading      Float? // degrés 0–360
  accuracy     Float? // rayon de confiance en mètres
  altitude     Float? // mètres
  batteryLevel Float? // V4 GPS — batterie du téléphone chauffeur (0–100)
  recordedAt   DateTime // horodatage ORIGINAL du GPS — jamais réécrit
  createdAt    DateTime        @default(now()) // réception serveur (diagnostic latence)

  @@unique([sessionId, positionId]) // V5 idempotence (null autorisé × N)
  @@index([sessionId, recordedAt])
}

// ============================================================
// V5 GPS — JOURNAL D'ÉVÉNEMENTS DE SUIVI (audit + alertes admin)
// Identifiants en chaînes simples (PAS de FK) : le journal survit
// aux suppressions et son écriture ne dépend d'aucune relation.
// ============================================================
model TrackingEvent {
  id          String   @id @default(cuid())
  sessionId   String?
  tripId      String?
  busId       String?
  driverId    String?
  agencyId    String?
  type        String
  severity    String   @default("INFO") // INFO | WARN | CRITICAL
  message     String?
  payloadJson String? // métadonnées sérialisées (jamais de secret)
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([agencyId, createdAt])
}

model Driver {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  phone         String?
  licenseNumber String   @unique
  userId        String?  @unique // lien optionnel vers un compte DRIVER
  user          User?    @relation(fields: [userId], references: [id])
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  status        String   @default("AVAILABLE") // AVAILABLE | ON_TRIP | OFF_DUTY
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trips            Trip[]
  trackingSessions TrackingSession[]

  @@index([agencyId])
  @@index([status])
  @@index([userId])
}

// ============================================================
// VOYAGES
// ============================================================

model Trip {
  id                   String   @id @default(cuid())
  code                 String   @unique
  routeId              String
  route                Route    @relation(fields: [routeId], references: [id])
  busId                String
  bus                  Bus      @relation(fields: [busId], references: [id])
  driverId             String?
  driver               Driver?  @relation(fields: [driverId], references: [id])
  agencyId             String
  agency               Agency   @relation(fields: [agencyId], references: [id])
  departureTime        DateTime
  estimatedArrivalTime DateTime
  price                Int // XAF — peut différer de route.basePrice (yield)
  status               String   @default("SCHEDULED") // SCHEDULED | BOARDING | DEPARTED | ARRIVED | CANCELLED | COMPLETED
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bookings         Booking[]
  occupancies      SeatOccupancy[]
  expenses         Expense[]
  tripRatings      TripRating[]      @relation("TripRatings")
  trackingSessions TrackingSession[]

  @@index([routeId])
  @@index([agencyId, departureTime])
  @@index([status, departureTime])
  @@index([departureTime])
  @@index([driverId])
}

// ============================================================
// PASSAGERS, RÉSERVATIONS & VERROU SIÈGES
// ============================================================

model Passenger {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  phone          String // E.164 digits (ex: 242061234567) — normalisé à la saisie
  email          String?
  documentNumber String?
  userId         String? // compte client lié — remonte les billets achetés sans compte
  user           User?    @relation("PassengerAccount", fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings      Booking[]
  occupancies   SeatOccupancy[] @relation("OccupancyPassenger")

  @@index([phone])
  @@index([email])
  @@index([userId])
}

model Booking {
  id               String    @id @default(cuid())
  bookingReference String    @unique // NZK-2026-A8F92K
  tripId           String
  trip             Trip      @relation(fields: [tripId], references: [id])
  passengerId      String
  passenger        Passenger @relation(fields: [passengerId], references: [id])
  seatId           String
  seat             Seat      @relation(fields: [seatId], references: [id])
  amount           Int // XAF figé à la réservation
  status           String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED | EXPIRED | COMPLETED
  channel          String    @default("WEB") // WEB | AGENT
  agencyId         String? // agence vendeuse (guichet)
  agency           Agency?   @relation(fields: [agencyId], references: [id])
  createdById      String? // agent utilisateur (si guichet)
  createdBy        User?     @relation("BookingCreator", fields: [createdById], references: [id])
  promoCode        String? // code fidélité/campagne appliqué (remise déjà déduite du montant)
  idempotencyKey   String? @unique // Idempotency-Key (hold/POST /api/bookings) — rejouer la requête ne crée JAMAIS deux réservations
  // Achat billet — quartier d'arrêt (destination) choisi par le passager,
  // configuré dans l'admin (Parc → Quartiers). null = arrêt principal.
  dropOffNeighborhoodId String?
  dropOffNeighborhood    Neighborhood? @relation("BookingDropOff", fields: [dropOffNeighborhoodId], references: [id])
  expiresAt        DateTime? // verrou 10 min quand PENDING
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payment   Payment[]
  ticket    Ticket?
  occupancies SeatOccupancy[] // multi-sièges : N verrous par réservation

  loyaltyTransactions LoyaltyTransaction[] @relation("LoyaltyBooking")
  tripRating          TripRating?          @relation("TripRatingBooking")

  @@index([tripId])
  @@index([status, expiresAt])
  @@index([agencyId, createdAt])
  @@index([bookingReference])
  @@index([createdAt])
}

// Verrou d'occupation de siège par voyage — LA disponibilité est TOUJOURS par voyage.
// Contrainte unique (tripId, seatId) = protection anti double réservation au niveau base.
// Multi-sites (architecture Océan du Nord) : cette table FUSIONNE TripSeat
// (état du siège pour UN voyage) et BookingSeat (lien réservation↔siège).
// Un booking multi-sièges = N lignes partageant le même bookingId.
// Statut exposé via l'API centrale : AVAILABLE (absence de ligne / verrou
// expiré) | HELD | PAID (= BOOKED) | BOARDED (ticket USED) | CANCELLED.
model SeatOccupancy {
  id          String     @id @default(cuid())
  tripId      String
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatId      String
  seat        Seat       @relation(fields: [seatId], references: [id])
  bookingId   String // PLUS unique : une réservation multi-sièges partage son id sur N lignes
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Passager de LA place (multi-passagers nommés) — null = passager acheteur
  passengerId String?
  passenger   Passenger? @relation("OccupancyPassenger", fields: [passengerId], references: [id])
  status      String     @default("HELD") // HELD (verrou temporaire) | BOOKED (confirmé/paid)
  expiresAt   DateTime?  // fin du verrou quand HELD
  createdAt   DateTime   @default(now())

  @@unique([tripId, seatId]) // ⚠️ verrou critique anti-concurrence (TripSeat)
  @@index([bookingId])
  @@index([passengerId])
  @@index([expiresAt])
  @@index([status])
}

// Événements de domaine — bus de synchronisation multi-sites (SITE CLIENT ↔
// SITE AGENCES via l'API centrale). Chaque mutation critique émet un événement
// consommable par polling GET /api/events/client (curseur `since`).
// Types : SEAT_HELD, SEAT_RELEASED, SEAT_PAID, SEAT_CANCELLED, BOOKING_CREATED,
// BOOKING_CONFIRMED, BOOKING_CANCELLED, BOOKING_EXPIRED, PAYMENT_SUCCESS,
// PAYMENT_FAILED, TICKET_CREATED, TICKET_CANCELLED, TICKET_BOARDED.
model DomainEvent {
  id            String   @id @default(cuid())
  type          String // cf. liste ci-dessus — vocabulaire partagé avec le SITE AGENCES
  aggregateType String // Trip | Booking | Payment | Ticket | Seat
  aggregateId   String
  tripId        String? // index de filtrage client (plan de sièges temps réel)
  bookingId     String? // index de filtrage réservation (suivi de commande)
  payload       String   @default("{}") // JSON sérialisé — jamais de donnée PII (ni téléphone, ni nom)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([tripId, createdAt])
  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

// ============================================================
// PAIEMENTS (architecture indépendante des fournisseurs)
// ============================================================

model Payment {
  id                    String   @id @default(cuid())
  bookingId             String
  booking               Booking  @relation(fields: [bookingId], references: [id])
  provider              String // MTN_MOMO | AIRTEL_MONEY | CASH | CARD | BANK_TRANSFER
  providerTransactionId String?  @unique // idempotence fournisseur/webhook
  amount                Int // XAF
  currency              String   @default("XAF")
  status                String   @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | CANCELLED | REFUNDED
  metadata              String? // JSON sérialisé (état MoMo, remboursements…)
  createdById           String? // encaisseur (CASH)
  createdBy             User?    @relation("PaymentCollector", fields: [createdById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transactions Transaction[]

  @@index([bookingId])
  @@index([status])
  @@index([provider])
  @@index([providerTransactionId])
  @@index([createdAt])
}

// ============================================================
// BILLETS & EMBARQUEMENT
// ============================================================

model Ticket {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  booking        Booking   @relation(fields: [bookingId], references: [id])
  token          String    @unique // QR : token aléatoire — JAMAIS de données passager
  boardingNumber String?   @unique // V3 — "NZK-8F42K9" : contrôle saisissable à la main (aléatoire sûr, PAS un compteur)
  status         String    @default("VALID") // VALID | USED | CANCELLED
  issuedAt       DateTime  @default(now())
  checkedAt      DateTime?
  checkedById    String?
  checkedBy      User?     @relation("TicketChecker", fields: [checkedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([token])
  @@index([boardingNumber])
  @@index([status])
  @@index([checkedById, checkedAt])
}

// ============================================================
// FINANCES
// ============================================================

model Transaction {
  id          String   @id @default(cuid())
  type        String // INCOME | EXPENSE | REFUND | ADJUSTMENT
  amount      Int // XAF, positif
  currency    String   @default("XAF")
  reference   String? // bookingReference / expense id / provider tx
  description String
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id])
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([agencyId, createdAt])
  @@index([createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  category    String // FUEL | MAINTENANCE | SALARY | REPAIR | SUPPLIES | OTHER
  amount      Int // XAF
  description String
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id])
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id])
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([agencyId, date])
  @@index([category])
  @@index([date])
}

// ============================================================
// NOTIFICATIONS, AUDIT & SÉCURITÉ
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // ex: BOOKING_CREATED, PAYMENT_CONFIRMED, PRICE_CHANGED...
  entity    String // ex: Booking, Trip, User...
  entityId  String?
  metadata  String? // JSON sérialisé
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([userId])
  @@index([createdAt])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String?
  event     String // LOGIN_FAILED | LOGIN_SUCCESS | RATE_LIMITED | ACCESS_DENIED | SUSPICIOUS | VALIDATION_ERROR
  ipAddress String?
  userAgent String?
  details   String? // JSON sérialisé
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([email])
  @@index([createdAt])
}

// ============================================================
// ESPACE CLIENT & FIDÉLISATION (Task ID 10)
// ============================================================

// Connexion rapide par téléphone : code à usage unique, hashé, expire vite.
// SMS_PROVIDER=none par défaut (sandbox/ZIP autonome) : le code est retourné
// en mode debug uniquement (OTP_DEBUG=true) — cf. README.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String // E.164 digits
  codeHash   String // SHA-256 du code — jamais en clair
  expiresAt  DateTime // 5 min
  attempts   Int       @default(0) // anti brute-force : 5 essais max
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

// ============================================================
// RÉINITIALISATION DE MOT DE PASSE (mode local / sandbox)
// ============================================================
// En mode Neon (production), la réinitialisation « mot de passe oublié »
// passe par le plugin Email OTP du service managé (webhook send.otp →
// livraison e-mail NZOKO, puis /email-otp/reset-password) : cette table
// n'est utilisée qu'en mode local (développement). Elle reste synchronisée
// dans les 2 schémas (convention du projet).
// TTL 15 min (aligné sur la durée des liens Neon), 5 tentatives max,
// usage unique — mêmes garde-fous que OtpCode.
model PasswordResetCode {
  id         String    @id @default(cuid())
  email      String // e-mail canonique (lowercase)
  codeHash   String // SHA-256 du code — jamais en clair
  expiresAt  DateTime // 15 min
  attempts   Int       @default(0) // anti brute-force : 5 essais max
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// Compte fidélité : 1 voyage payé = 100 points. Paliers sur les points
// cumulés (lifetime) : BRONZE 0+ | SILVER 1 000+ | GOLD 5 000+ | VIP 15 000+.
model LoyaltyAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  pointsBalance  Int      @default(0) // points dépensables
  lifetimePoints Int      @default(0) // cumul historique → palier
  tier           String   @default("BRONZE") // BRONZE | SILVER | GOLD | VIP
  updatedAt      DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@index([tier])
}

// Journal des points. bookingId unique = attribution idempotente
// (1 paiement réussi = 1 gain, même si le webhook rejoue).
model LoyaltyTransaction {
  id          String         @id @default(cuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id])
  type        String // EARN | SPEND | ADJUST
  points      Int // positif (le sens est porté par type)
  reason      String // VOYAGE | REDUCTION_5 | REDUCTION_10 | SPECIAL | FREE_TICKET | ADMIN
  bookingId   String?        @unique
  booking     Booking?       @relation("LoyaltyBooking", fields: [bookingId], references: [id])
  description String
  createdAt   DateTime       @default(now())

  @@index([accountId, createdAt])
}

// Trajets favoris : ajout manuel OU détection automatique des habitudes.
model FavoriteRoute {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  originCityId      String
  originCity        City     @relation("FavoriteOrigin", fields: [originCityId], references: [id])
  destinationCityId String
  destinationCity   City     @relation("FavoriteDestination", fields: [destinationCityId], references: [id])
  isManual          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, originCityId, destinationCityId])
  @@index([userId])
}

// Réclamations & suggestions — référence NZK-R-2026-XXXXXX.
model Complaint {
  id               String    @id @default(cuid())
  reference        String    @unique
  userId           String
  user             User      @relation("ComplaintAuthor", fields: [userId], references: [id])
  category         String // TICKET | BUS | STAFF | PAYMENT | DELAY | SUGGESTION | COMPLAINT
  subject          String
  message          String
  bookingReference String? // réservation liée (optionnel)
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  assignedToId     String?
  assignedTo       User?     @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  satisfaction     Int? // 1-5 éventuellement collecté à la clôture
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages ComplaintMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId])
}

// Fil de discussion d'une réclamation (client ↔ support).
model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation("ComplaintMessages", fields: [authorId], references: [id])
  isStaff     Boolean   @default(false)
  authorName  String // libellé direct : "Moi" | "Support NZOKO" | "Système"
  message     String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}

// Évaluation post-voyage : 5 critères (1-5) + commentaire.
// Unique par réservation → un voyage = une évaluation.
model TripRating {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation("TripRatingBooking", fields: [bookingId], references: [id])
  tripId      String
  trip        Trip     @relation("TripRatings", fields: [tripId], references: [id])
  userId      String
  user        User     @relation("TripRatings", fields: [userId], references: [id])
  cleanliness Int // 1-5 Propreté
  comfort     Int // 1-5 Confort
  punctuality Int // 1-5 Ponctualité
  staff       Int // 1-5 Personnel
  security    Int // 1-5 Sécurité
  average     Int // moyenne arrondie, calculée à l'insertion
  comment     String?
  createdAt   DateTime @default(now())

  @@index([tripId])
  @@index([userId, createdAt])
}

// Demande de récompense (dépense de points) — validée par l'administration.
// À l'approbation : débit des points + génération d'un code promo PERCENT.
model RedemptionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("RedemptionRequester", fields: [userId], references: [id])
  rewardKey   String // REDUCTION_5 | REDUCTION_10 | SPECIAL | FREE_TICKET
  pointsSpent Int
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  promoCode   String?   @unique
  decidedById String?
  decidedBy   User?     @relation("RedemptionDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String? // motif de refus / instructions
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Codes promo applicables à la réservation (fidélité & campagnes).
// type PERCENT : value = % de remise ; FREE_TICKET : traité par l'équipe.
model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique // ex: NZOKO-XY7K2M
  type      String // PERCENT | FREE_TICKET
  value     Int
  label     String
  userId    String? // réservé à un client ; null = public
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isActive, expiresAt])
}

// ============================================================
// V3 — ASSISTANT IA : BASE DE CONNAISSANCES & JOURNAL
// ============================================================

// FAQ officielle pilotée par l'administration : le LLM répond UNIQUEMENT
// à partir de ces entrées + des données dynamiques (horaires/tarifs/agences
// calculés en base). Toute réponse hors base = refus + escalade humaine.
model KnowledgeBase {
  id          String   @id @default(cuid())
  title       String
  question    String
  answer      String
  category    String // HORAIRES | TARIFS | AGENCES | RESERVATION | PAIEMENT | BAGAGES | EMBARQUEMENT | ANNULATION | REMBOURSEMENT | CONTACT | SERVICES | GPS | FIDELITE | RECLAMATIONS
  keywords    String   @default("") // mots-clés séparés par virgules (matching serveur, insensible aux accents)
  cityId      String? // portée optionnelle : FAQ valable pour une ville
  agencyId    String? // portée optionnelle : FAQ valable pour une agence
  isActive    Boolean  @default(true)
  priority    Int      @default(0) // FAQ prioritaires d'abord
  version     Int      @default(1) // incrémenté à chaque modification
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city      City?   @relation(fields: [cityId], references: [id])
  agency    Agency? @relation(fields: [agencyId], references: [id])
  createdBy User?   @relation("KBCreatedBy", fields: [createdById], references: [id])
  updatedBy User?   @relation("KBUpdatedBy", fields: [updatedById], references: [id])

  @@index([category, isActive])
  @@index([isActive, priority])
  @@index([cityId])
  @@index([agencyId])
  @@index([updatedAt])
}

// Journal des questions posées à l'assistant — pilotage qualité :
// questions fréquentes, non résolues, mal comprises → enrichir la FAQ.
// ⚠️ Nom du modèle : `AiQuestionLog` (PAS d'acronyme en tête — cf. en-tête
// de fichier) + @@map("AIQuestionLog") pour conserver la table historique
// (SQLite sandbox ET Neon production) sans migration de données.
model AiQuestionLog {
  id         String   @id @default(cuid())
  sessionId  String
  question   String
  answer     String
  confidence Float? // 0-1 (1 = réponse FAQ directe, LLM = heuristique)
  resolved   Boolean  @default(false)
  category   String?
  cityId     String?
  agencyId   String?
  createdAt  DateTime @default(now())

  city   City?   @relation(fields: [cityId], references: [id])
  agency Agency? @relation(fields: [agencyId], references: [id])

  @@index([resolved, createdAt])
  @@index([createdAt])
  @@index([category])
  @@index([sessionId])

  @@map("AIQuestionLog")
}
